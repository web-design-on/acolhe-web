# URL base da API (backend). "/api" usa o back-end deste repositório (proxy do Vite em dev, mesma origem no Vercel).
VITE_API_URL=/api
# false = esconde no login os botões das contas de demonstração (ana@ / paulo@exemplo.com)
VITE_DEMO_LOGIN=true
# true = usa dados simulados de src/mocks; false = chama a API real
VITE_USE_MOCKS=true

# ─── Back-end (pasta server/) ───
# Banco do Acolhe no Prisma Postgres (console.prisma.io → projeto acolhe → Connect). É o mesmo do back-end do app.
DATABASE_URL=postgres://USUARIO:SENHA@db.prisma.io:5432/postgres?sslmode=require
# Segredo usado para assinar os tokens de login. Gere um com: openssl rand -base64 32
JWT_SECRET=troque-este-segredo
# Porta da API local (o Vite encaminha /api para ela)
API_PORT=3334
# Origens liberadas no CORS, separadas por vírgula. Só o app rodando no navegador precisa (expo start --web).
CORS_ORIGINS=http://localhost:8081
